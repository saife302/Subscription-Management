NODE_ENV=development
PORT=4000

# AWS RDS PostgreSQL connection
# Example: postgresql://postgres:<password>@brightloop-db.xxxx.ap-south-1.rds.amazonaws.com:5432/brightloop
DATABASE_URL=postgresql://postgres:password@your-rds-instance.ap-south-1.rds.amazonaws.com:5432/brightloop
DB_SSL=true

JWT_SECRET=brightloop-local-dev-secret-key-min-32-chars-2026
JWT_EXPIRES_IN=7d

CORS_ORIGINS=http://localhost:5173
WEB_URL=http://localhost:5173

EMAIL_PROVIDER=console
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Brightloop
BREVO_TEMPLATE_RESET_ID=

TZ=Asia/Kolkata
RUN_JOBS=true
BILLING_CRON=30 0 * * *
CUSTOMER_SELF_SERVICE=false

COMPANY_NAME=Brightloop Software
COMPANY_ADDRESS=100 Residency Road, Bengaluru, Karnataka 560025, IN
COMPANY_TAX_ID=29AABCB1234F1Z5
COMPANY_EMAIL=billing@brightloop.test
